{
  "name": "rox-live-quiz",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vp dev'",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vp build",
    "format": "vp fmt",
    "lint": "vp lint --deny-warnings",
    "tokens": "node scripts/generate-tokens.mjs",
    "format:check": "vp fmt --check",
    "lint:fix": "vp lint --fix",
    "prepare": "vp config",
    "check": "vp check",
    "preview": "npm run build && wrangler dev",
    "deploy": "convex deploy --cmd 'npm run build' && wrangler deploy"
  },
  "dependencies": {
    "@convex-dev/react-query": "0.1.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "cn": "0.4.0",
    "convex": "1.46.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vite-tsconfig-paths": "6.1.1",
    "wrangler": "4.142.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "download"
    }
  }
}

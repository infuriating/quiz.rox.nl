{
  "name": "rox-live-quiz",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'vite dev'",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node .output/server/index.mjs",
    "format": "oxfmt",
    "lint": "npm run typecheck && oxlint --deny-warnings",
    "tokens": "node scripts/generate-tokens.mjs",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@convex-dev/react-query": "^0.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.36",
    "cn": "0.4.0",
    "convex": "^1.44.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "9.39.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
